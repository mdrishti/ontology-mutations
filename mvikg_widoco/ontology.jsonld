  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/object",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Association"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "object"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/biolink/vocab/NamedThing"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "connects an association to the object of the association. For example, in a gene-to-phenotype association, the gene is subject and phenotype is object."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.org/oban/association_has_object"
  }, {
    "@id" : "http://www.w3.org/2002/07/owl#annotatedTarget"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/opposite_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "opposite of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://doi.org/10.1101/108977"
  }, {
    "@id" : "https://github.com/biolink/biolink-model/issues/657"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "x is the opposite of y if there exists some distance metric M, and there exists no z such as M(x,z) <= M(x,y) or M(y,z) <= M(y,x). (This description is from RO. Needs to be rephrased)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/RO_0002604"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
