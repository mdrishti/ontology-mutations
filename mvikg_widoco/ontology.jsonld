}, {
  "@id" : "http://www.linkedmodel.org/schema/dtype#GMD_DTYPE",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2011-05-29"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2023-11-14"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "DTYPE Version 2.1 Metadata"
  } ],
  "http://www.linkedmodel.org/schema/vaem#description" : [ {
    "@value" : "\nThe ontology \"dtype\" provides a specification of simple data types such as enumerations and codelists.\nThese are needed in support of the conversion of XML Schemas and UML Models to OWL.\nThe purpose of \"dtype\" is to provide a foundation for expressing rich data types.\nThese data types are typically needed when dealing with OWL representations of data structures derived from XML Schema.\n"
  } ],
  "http://www.linkedmodel.org/schema/vaem#hasGraphRole" : [ {
    "@id" : "http://www.linkedmodel.org/schema/vaem#SchemaGraph"
  } ],
  "http://www.linkedmodel.org/schema/vaem#hasLicenseType" : [ {
    "@id" : "http://voag.linkedmodel.org/voag/CC-SHAREALIKE_3PT0-US"
  } ],
