    "@value" : "unsigned"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unsigned"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/Unit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "\n  A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension).\n  For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).\n  Any measurement of the length can be expressed as a number multiplied by the unit meter.\n  More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$.\n  "
  } ],
  "http://qudt.org/schema/qudt/informativeReference" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://dbpedia.org/resource/Category:Units_of_measure"
  }, {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://www.allmeasures.com/Fullconversion.asp"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Concept"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/Unordered",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "Unordered structure."
  } ],
  "http://www.linkedmodel.org/schema/dtype#literal" : [ {
    "@value" : "unordered"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/OrderedType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unordered"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/UnsignedIntegerEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "4"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/IntegerEncodingType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unsigned Integer Encoding"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/allowedUnitOfSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "This property relates a unit of measure with a unit system that does not define the unit, but allows its use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system."
  } ],
  "http://purl.org/dc/terms/isReplacedBy" : [ {
    "@id" : "http://qudt.org/schema/qudt/applicableSystem"
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "allowed unit of system"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/applicableSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "This property relates a unit of measure with a unit system that may or may not define the unit, but within which the unit is compatible."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "applicable system"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/bits",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bits"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/bytes",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bytes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/code",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A code is a string that uniquely identifies a QUDT concept. The use of this property has been deprecated."
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "code"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/coherentUnitOfSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "\n  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one.\n  A system of units is coherent with respect to a system of quantities and equations if the system of units is chosen in such a way\n   that the equations between numerical values have exactly the same form (including the numerical factors) as the corresponding equations between the quantities.\n  For example, the 'newton' and the 'joule'.\n  These two are, respectively, the force that causes one kilogram to be accelerated at 1 metre per second per second,\n   and the work done by 1 newton acting over 1 metre.\n  Being coherent refers to this consistent use of 1.\n  In the old c.g.s. system , with its base units the centimetre and the gram, the corresponding coherent units were the dyne and the erg,\n   respectively the force that causes 1 gram to be accelerated at 1 centimetre per second per second, and the work done by 1 dyne acting over 1 centimetre.\n  So $1 newton = 10^5\\,dyne$, $1 joule = 10^7\\,erg$, making each of the four compatible in a decimal sense within its respective other system, but not coherent therein.\n  "
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is coherent unit of system"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/dbpediaMatch",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dbpedia match"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/deprecated",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "deprecated"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
