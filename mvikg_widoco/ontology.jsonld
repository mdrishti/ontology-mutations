  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "narrow match"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "a list of terms from different schemas or terminology systems that have a narrower, more specific meaning. Narrower terms are typically shown as children in a hierarchy or tree."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#narrowMatch"
