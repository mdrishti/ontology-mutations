  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has steward"
  } ]
}, {
  "@id" : "http://www.linkedmodel.org/schema/vaem#intent",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The property \"vaem:intent\" is used to outline  a statement of purpose. This typically expresses one or more desired outcomes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.linkedmodel.org/2.0/schema/vaem"
