}, {
  "@id" : "https://w3id.org/biolink/vocab/positively_correlated_with",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "positively correlated with"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A relationship that holds between two concepts represented by variables for which a statistical correlation is demonstrated, wherein variable values move together in the same direction (i.e. increased in one or presence of one correlates with an increase or presence of the other)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://ctdbase.org/positive_correlation"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "negatively correlated with"
  } ]
