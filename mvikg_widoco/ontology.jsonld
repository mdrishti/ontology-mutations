  "@id" : "https://w3id.org/biolink/vocab/sequence_localization_attribute",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sequence localization attribute"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An attribute that can be applied to a genome sequence localization edge. These edges connect a nucleic acid entity such as an exon to an entity such as a chromosome. Edge properties are used to ascribe specific positional information and other metadata to the localization. In pragmatic terms this can be thought of as columns in a GFF3 line."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
