  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "In MVIKG: instances are minted per-record (scoped to document + organism + gene symbol), not shared across papers/organisms, to avoid collisions when the same gene symbol denotes different genes in different organisms. The canonical resolved gene identity is reachable one hop away via dcterms:identifier. The same per-record blank-node pattern applies to biolink:SequenceVariant and biolink:PhenotypicFeature instances."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "genomic entity"
  } ],
