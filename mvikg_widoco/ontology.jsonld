    "@value" : "Byte Encoding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Encoding"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/CT_COUNTABLY-INFINITE",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "\n  A set of numbers is called countably infinite if there is a way to enumerate them.\n  Formally this is done with a bijection function that associates each number in the set with exactly one of the positive integers.\n  The set of all fractions is also countably infinite.\n  In other words, any set $X$ that has the same cardinality as the set of the natural numbers,\n   or $| X | \\; =  \\; | \\mathbb N | \\; = \\; \\aleph0$, is said to be a countably infinite set.\n  "
  } ],
  "http://qudt.org/schema/qudt/informativeReference" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://www.math.vanderbilt.edu/~schectex/courses/infinity.pdf"
  } ],
  "http://www.linkedmodel.org/schema/dtype#literal" : [ {
    "@value" : "countable"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/CardinalityType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Countably Infinite Cardinality Type"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/CT_FINITE",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "Any set $X$ with cardinality less than that of the natural numbers, or $| X | \\\\; <  \\; | \\\\mathbb N | $, is said to be a finite set."
  } ],
  "http://www.linkedmodel.org/schema/dtype#literal" : [ {
    "@value" : "finite"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/CardinalityType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Finite Cardinality Type"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/CT_UNCOUNTABLE",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "Any set with cardinality greater than that of the natural numbers, or $| X | \\; >  \\; | \\mathbb N | $,  for example $| R| \\; =  \\;  c  \\; > |\\mathbb N |$, is said to be uncountable."
  } ],
  "http://www.linkedmodel.org/schema/dtype#literal" : [ {
    "@value" : "uncountable"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/CardinalityType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Uncountable Cardinality Type"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/CardinalityType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://qudt.org/schema/qudt/LatexString",
    "@value" : "\n  In mathematics, the cardinality of a set is a measure of the number of elements of the set.\n  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3.\n  There are two approaches to cardinality: one which compares sets directly using bijections and injections,\n   and another which uses cardinal numbers.\n  "
  } ],
  "http://qudt.org/schema/qudt/informativeReference" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://en.wikipedia.org/wiki/Cardinal_number"
  }, {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://en.wikipedia.org/wiki/Cardinality"
  } ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "In mathematics, the cardinality of a set is a measure of the number of elements of the set.  For example, the set 'A = {2, 4, 6}' contains 3 elements, and therefore 'A' has a cardinality of 3. There are two approaches to cardinality – one which compares sets directly using bijections and injections, and another which uses cardinal numbers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Cardinality Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/EnumeratedValue"
  }, {
    "@id" : "_:genid200"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid196"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/CharEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@value" : "7 bits of 1 octet"
  } ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
