    "@value" : "gene or gene product"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/MacromolecularMachineMixin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A union of gene loci or gene products. Frequently an identifier for one will be used as proxy for another"
