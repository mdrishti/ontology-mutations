}, {
  "@id" : "http://www.linkedmodel.org/schema/dtype#EnumeratedValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "\nThe base class for datatypes that have values that are restriced to a set of literals or tokens.\nThe members of the restriction may themselves be restriced by facets that apply to scalar data types.\n"
  } ],
