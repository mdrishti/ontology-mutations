  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "derived quantity kind of system"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/fieldCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "A field code is a generic property for representing unique codes that make up other identifers. For example each QuantityKind class caries a domain code as its field code."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "field code"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/generalization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "This deprecated property was intended to relate a quantity kind to its generalization."
  } ],
  "http://purl.org/dc/terms/isReplacedBy" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#broader"
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "generalization"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/hasCitation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "Used to provide an annotation for an informative reference."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "citation"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/hasNonCoherentUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one."
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has non-coherent unit"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/hasUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "This property relates a system of units with a unit of measure that is either a) defined by the system, or b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system. Systems of units may distinguish between base and derived units. Base units are the units which measure the base quantities for the corresponding system of quantities. The base units are used to define units for all other quantities as products of powers of the base units. Such units are called derived units for the system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has unit"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/hasVocabulary",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "Used to relate a class to one or more graphs where vocabularies for the class are defined."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has vocabulary"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/informativeReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://qudt.org/schema/qudt/isBaseQuantityKindOfSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is base quantity kind of system"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/isQuantityKindOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "`qudt:isQuantityKindOf` was a strict inverse of `qudt:hasQuantityKind` but is now deprecated."
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is quantity kind of"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/numericValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "numeric value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://qudt.org/schema/qudt/NumericUnion"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/plainTextDescription",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A plain text description is used to provide a description with only simple ASCII characters for cases where LaTeX , HTML or other markup would not be appropriate."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "description (plain text)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/specialization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/description" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "This deprecated property originally related a quantity kind to its specialization(s). For example, linear velocity and angular velocity are both specializations of velocity."
  } ],
  "http://qudt.org/schema/qudt/deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
