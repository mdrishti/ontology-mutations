  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A mixin that can be used on any entity that can be taxonomically classified. This includes individual organisms; genes, their products and other molecular entities; body parts; biological processes"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/VariantToEntityAssociationMixin",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "variant to entity association mixin"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/linkml/ClassDefinition#Mixin"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/VariantToGeneAssociation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "variant to gene association"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Association"
  }, {
    "@id" : "_:genid322"
  }, {
    "@id" : "_:genid323"
  }, {
    "@id" : "_:genid324"
  }, {
    "@id" : "_:genid325"
  }, {
    "@id" : "_:genid326"
  }, {
    "@id" : "_:genid327"
  }, {
    "@id" : "_:genid328"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An association between a variant and a gene, where the variant has a genetic association with the gene (i.e. is in linkage disequilibrium)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/agent_type",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Association"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "agent type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/biolink/vocab/AgentTypeEnum"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Describes the high-level category of agent who originally generated a statement of knowledge or other type of information."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Note that this property indicates the type of agent who produced a final statement of knowledge, which is often different from the agent oragents who produced information used as evidence to support generation of this knowledge. For example, if a human curator concludes that a particular gene variant causes a medical condition - based on their interpretation of information produced by computational modeling tools, automated data analysis pipelines, and robotic laboratory assay systems - the agent_type for this statement is 'manual agent' - despite all of the evidence being created by automated agents. But if any of these systems is programmed to generate knowledge statements directly and without human assistance, the statement would be attributed to an 'automated_agent'."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/ameliorates_condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ameliorates condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "ameliorates"
  }, {
    "@value" : "beneficial for condition"
  }, {
    "@value" : "therapeutic for condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Holds between an entity and an existing medical condition (disease or phenotypic feature) where the entity is able to ameliorate symptoms, stabilize progression, or cure the condition."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "This predicate describes a narrower view of 'treats' - that covers interventions that are beneficial for existing disease, and excludes interventions that prevent/reduce risk of developing a condition in the future."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/RO_0003307"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "exacerbates condition"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/association_slot",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Association"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "association slot"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "edge property"
  }, {
    "@value" : "edge qualifier"
  }, {
    "@value" : "node qualifier"
  }, {
    "@value" : "statement property"
  }, {
    "@value" : "statement qualifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "any slot that relates an association to another entity"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/broad_match",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "broad match"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "a list of terms from different schemas or terminology systems that have a broader, more general meaning. Broader terms are typically shown as parents in a hierarchy or tree."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#broadMatch"
  }, {
    "@id" : "https://www.wikidata.org/entity/Q39894595"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "narrow match"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/canonical_predicate",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/category",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "category"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/type"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Name of the high level ontology class in which this entity is categorized. Corresponds to the label for the biolink entity type class. In a neo4j database this MAY correspond to the neo4j label tag. In an RDF database it should be a biolink model class URI. This field is multi-valued. It should include values for ancestors of the biolink class; for example, a protein such as Shh would have category values `biolink:Protein`, `biolink:GeneProduct`, `biolink:MolecularEntity`. In an RDF database, nodes will typically have an rdf:type triples. This can be to the most specific biolink class, or potentially to a class more specific than something in biolink. For example, a sequence feature `f` may have a rdf:type assertion to a SO class such as TF_binding_site, which is more specific than anything in biolink. Here we would have categories {biolink:GenomicEntity, biolink:MolecularEntity, biolink:NamedThing}"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/contraindicated_in",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "contraindicated in"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Holds between a substance, procedure, or activity and a medical condition or circumstance, where an authority has established that the substance, procedure, or activity should not be applied as an intervention in patients with the condition or circumstance because it can result in detrimental outcomes."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "This predicate relates the intervention with a specific disease, phenotype, or other medical circumstance that puts patients at high risk for detrimental outcomes.  This may be a different condition from the one that the drug would be used to treat (e.g. pseudoephedrine is contraindicated in people with high-blood pressure as a treatment for nasal congestion), a biological state (e.g. isotretinoin is contraindicated in people who are pregnant as a treatment for acne), or being on a different medication (e.g. aspirin is contraindicated in people taking warfarin as a preventative treatment for stroke)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/NCIT_C37933"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "treats"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/decreases_sensitivity_to",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "decreases sensitivity to"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "holds between two chemical entities or genes or gene products where the action or effect of one decreases the susceptibility/sensitivity of a biological entity or system (e.g. an organism, cell, cellular component, macromolecular machine mixin, biological or pathological process) to the other"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://ctdbase.org/decreases_response_to"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "http://ctdbase.org/decreases_response_to_substance"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "increases sensitivity to"
  } ]
}, {
