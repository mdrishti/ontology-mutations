  }, {
    "@id" : "_:genid165"
  }, {
    "@id" : "_:genid166"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "allele"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/GENO_0000002"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/SO_0001060"
  }, {
    "@id" : "http://semanticscience.org/resource/SIO_010277"
  }, {
    "@id" : "https://datacommons.org/browser/Allele"
  }, {
    "@id" : "https://github.com/ga4gh/vr-spec/Allele"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A sequence_variant is a non exact copy of a sequence_feature or genome exhibiting one or more sequence_alteration."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://www.wikidata.org/entity/Q15304597"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "This class is for modeling the specific state at a locus. A single DBSNP rs ID could correspond to more than one sequence variants (e.g CIViC:1252 and CIViC:1253, two distinct BRCA2 alleles for rs28897743)"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/Serial",
