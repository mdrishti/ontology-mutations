  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A region (or regions) that includes all of the sequence elements necessary to encode a functional transcript. A gene locus may include regulatory regions, transcribed regions and/or other functional sequence regions."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
