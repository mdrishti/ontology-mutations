}, {
  "@id" : "http://qudt.org/schema/qudt/DerivedUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/dbpediaMatch" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://dbpedia.org/resource/Category:SI_derived_units"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A DerivedUnit is a type specification for units that are derived from other units."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Derived Unit"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/DoublePrecisionEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
