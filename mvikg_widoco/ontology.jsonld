}, {
  "@id" : "http://example.org/mvikg",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "MVIKG"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "An integrated ontology combining BioLink, SOSA, ENVO, RO, GOLD and other established ontologies for bacterial variant data modeling"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "MVIKG: Multi-Variant Integration Knowledge Graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A schema for bacterial genotype-phenotype data integration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "MVIKG Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://example.org/mvikg/0.0.1"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.0.1"
  } ]
}, {
  "@id" : "http://example.org/mvikg/Biome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "We recommend any biome class from the GOLD ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "GOLD Biome"
  } ]
}, {
  "@id" : "http://example.org/mvikg/DevelopmentalStage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A developmental stage is a stage corresponding to a stage in bacteria's  growth. e.g.: exponential, lag."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Developmental stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://www.ebi.ac.uk/efo/EFO_0000399"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a specific point or period in an organism's life cycle"
  } ]
}, {
  "@id" : "http://example.org/mvikg/alt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
