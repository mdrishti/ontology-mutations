  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/PhysicalConstant",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/dbpediaMatch" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://dbpedia.org/resource/Physical_constant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A physical constant is a physical quantity that is generally believed to be both universal in nature and constant in time. It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. There are many physical constants in science, some of the most widely recognized being the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h, the electric permittivity of free space ε0, and the elementary charge e. Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Physical Constant"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/Quantifiable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "<p><em>Quantifiable</em> ascribes to some thing the capability of being measured, observed, or counted.</p>"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Quantifiable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid221"
  }, {
    "@id" : "_:genid222"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/Quantity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/dbpediaMatch" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "http://dbpedia.org/resource/Quantity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "<p class=\"lm-para\">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system.\n  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the\n  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific\n  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as\n  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>\n<p class=\"lm-para\">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points,\nvelocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p>\n<p class=\"lm-para\">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity\nkinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance\ndivided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these\nexpressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded\nas \"fundamental\" in this sense.</p>\n<p class=\"lm-para\">A quantity is distinguished from a \"quantity kind\" in that the former carries a value and the latter is a type specifier.</p>"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Quantity"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/QuantityValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@type" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML",
    "@value" : "A <i>Quantity Value</i> expresses the magnitude and kind of a quantity and is given by the product of a numerical value <code>n</code> and a unit of measure <code>U</code>. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to <a href=\"http://physics.nist.gov/Pubs/SP811/sec07.html\">NIST SP 811 section 7</a> for more on quantity values."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Quantity value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Concept"
  }, {
    "@id" : "http://qudt.org/schema/qudt/Quantifiable"
  }, {
    "@id" : "_:genid223"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/SIGNED",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.linkedmodel.org/schema/dtype#literal" : [ {
    "@value" : "signed"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Signed"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/ScaleType",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/plainTextDescription" : [ {
    "@value" : "Scales, or scales of measurement (or categorization) provide ways of quantifying measurements, values and other enumerated values according to a normative frame of reference.  Four different types of scales are typically used. These are interval, nominal, ordinal and ratio scales."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Scale type"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/ShortSignedIntegerEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/IntegerEncodingType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Short Signed Integer Encoding"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/ShortUnsignedIntegerEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/BooleanEncodingType"
  }, {
    "@id" : "http://qudt.org/schema/qudt/IntegerEncodingType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Short Unsigned Integer Encoding"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/SignedIntegerEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "4"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/IntegerEncodingType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Signed Integer Encoding"
  } ]
}, {
  "@id" : "http://qudt.org/schema/qudt/SinglePrecisionRealEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://qudt.org/schema/qudt/bytes" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "32"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/FloatingPointEncodingType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Single Precision Real Encoding"
  } ]
}, {
