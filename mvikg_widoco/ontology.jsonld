  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/disrupts",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "disrupts"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "disease causes disruption of"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "describes a relationship where one entity degrades or interferes with the structure, function, or occurrence of another."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://skr3.nlm.nih.gov/SemMedDBDISRUPTS"
  }, {
