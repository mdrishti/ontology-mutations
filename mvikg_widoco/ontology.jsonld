  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "journal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "This class may rarely be instantiated except if use cases of a given knowledge graph support its utility."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/ThingWithTaxon",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "thing with taxon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/linkml/ClassDefinition#Mixin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A mixin that can be used on any entity that can be taxonomically classified. This includes individual organisms; genes, their products and other molecular entities; body parts; biological processes"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/WebPage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "web page"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Publication"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "a document that is published according to World Wide Web standards, which may incorporate text, graphics, sound, and/or other features."
