    "@value" : "A sequence alteration which included an insertion and a deletion, affecting 2 or more bases."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@value" : "http://en.wikipedia.org/wiki/Indel"
  }, {
    "@value" : "loinc:LA9659-9"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@value" : "deletion-insertion"
  }, {
    "@value" : "indel"
  } ],
