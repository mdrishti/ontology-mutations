  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A union of gene locus, gene product, and macromolecular complex. These are the basic units of function in a cell. They either carry out individual biological activities, or they encode molecules which do this."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
