  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/RO_0004024"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/RO_0004025"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "enables"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/enabled_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "enabled by"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "holds between a process and a physical entity, where the physical entity executes the process"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/RO_0002333"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "prevented by"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/end_interbase_coordinate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "end interbase coordinate"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://biohackathon.org/resource/faldo#end"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
