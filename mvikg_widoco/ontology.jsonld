    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The alternate (variant) allele observed at a given sequence position."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://example.org/mvikg/linkml"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl."
  } ]
}, {
