  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/base_coordinate"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "start"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://biohackathon.org/resource/faldo#begin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The position at which the subject genomic entity starts on the chromosome or other entity to which it is located on. (ie: the start of the sequence being referenced is 1)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
