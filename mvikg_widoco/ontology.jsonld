}, {
  "@id" : "https://w3id.org/biolink/vocab/increases_sensitivity_to",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "increases sensitivity to"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "holds between two chemical entities or genes or gene products where the action or effect of one increases the susceptibility/sensitivity of a biological entity or system (e.g. an organism, cell, cellular component, macromolecular machine mixin, biological or pathological process) to the other"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://ctdbase.org/increases_response_to"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "https://w3id.org/biolink/vocab/opposite_of" : [ {
    "@value" : "decreases sensitivity to"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/is_sequence_variant_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/SequenceVariant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is sequence variant of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/biolink/vocab/GenomicEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/related_to_at_instance_level"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "allelic variant of"
  }, {
    "@value" : "gene product sequence variation encoded by gene mutant"
  }, {
    "@value" : "gene product variant of gene product"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "holds between a sequence variant and a nucleic acid entity"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "https://www.wikidata.org/entity/P3433"
  } ],
  "https://w3id.org/biolink/vocab/canonical_predicate" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/knowledge_level",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/biolink/vocab/Association"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "knowledge level"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/biolink/vocab/KnowledgeLevelEnum"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "knowledge type"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Describes the level of knowledge expressed in a statement, based on the reasoning or analysis methods used to generate the statement, or the scope or specificity of what the statement expresses to be true."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "The notion of a 'level' of knowledge can in one sense relate to the strength of a statement - i.e. how confident we are that it says something true about our domain of discourse. Here, we can generally consider Assertions to be stronger than Entailments to be stronger than Predictions. But in another sense, 'level' of knowledge can refer to the scope or specificity of what a statement expresses - on a spectrum from context-specific results of a data analysis, to generalized assertions of knowledge or fact. Here, Statistical Associations and  Observations represent more foundational statements that are only slightly removed from the data on which they are based (the former reporting the direct results of  an analysis in terms of correlations between variables in the data, and the latter describing phenomena that were observed/reported to have occurred)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/lacks_part",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lacks part"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CL_lacks_part"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/PR_lacks_part"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
