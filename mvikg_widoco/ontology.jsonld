  "http://purl.org/dc/terms/description" : [ {
    "@value" : "A property that is used to refer to a \"Steward\", that is, the party or role that is responsible for maintaining an asset, in the case of VAEM, an ontology graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
