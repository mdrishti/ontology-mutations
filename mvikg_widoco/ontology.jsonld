}, {
  "@id" : "http://www.linkedmodel.org/schema/dtype#literal",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "\nA general purpose property for holding string literals as a machine-readable string for how the\nenumerated value can be referred to.\nThis can be used when the code value is numeric, as an alternative to using a code.\nLiteral is not the same as label which is intended for human readable display.\nFor example, a code for January may be 1, the literal may be 'J' or 'jan' and the label 'January'.\n"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : ""
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt"
  }, {
    "@id" : "http://www.linkedmodel.org/schema/dtype"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "literal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.linkedmodel.org/schema/dtype#literal"
  } ]
}, {
  "@id" : "http://www.linkedmodel.org/schema/dtype#value",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "\nThe property \"dtype:value\" is a general property for specifying a literal value in situations where\nnone is specified.\n"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.linkedmodel.org/schema/dtype"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anySimpleType"
  } ]
