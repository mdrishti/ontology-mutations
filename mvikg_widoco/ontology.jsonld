  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/Publication",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "publication"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/InformationContentEntity"
  }, {
    "@id" : "_:genid156"
  }, {
    "@id" : "_:genid157"
  }, {
    "@id" : "_:genid158"
  }, {
    "@id" : "_:genid159"
  }, {
    "@id" : "_:genid160"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Any ‘published’ piece of information. Publications are considered broadly to include any document or document part made available in print or on the web - which may include scientific journal issues, individual articles, and books - as well as things like pre-prints, white papers, patents, drug labels, web pages, protocol documents,  and even a part of a publication if of significant knowledge scope (e.g. a figure, figure legend, or section highlighted by NLP)."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000311"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/biolink/biolink-model"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowMatch" : [ {
    "@id" : "http://purl.bioontology.org/ontology/STY/T170"
  }, {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000013"
  } ]
}, {
  "@id" : "https://w3id.org/biolink/vocab/SequenceVariant",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "In MVIKG: A genomic variant associated with a specific gene"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "sequence variant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/biolink/vocab/BiologicalEntity"
  }, {
    "@id" : "_:genid161"
