                                          rdfs:domain <https://w3id.org/biolink/vocab/Publication> ;
                                          rdfs:range <http://www.w3.org/ns/sosa/Sample> ;
                                          rdfs:label "mentions" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "refers to is a relation between one information content entity and the named thing that it makes reference to." ;
