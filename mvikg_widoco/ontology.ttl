                                      rdfs:domain <https://w3id.org/biolink/vocab/Entity> ;
                                      rdfs:range xsd:anyURI ;
                                      rdfs:label "type" ;
                                      <http://www.w3.org/2004/02/skos/core#exactMatch> <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#type> ,
                                                                                       <https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_Type> ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


