###  https://w3id.org/biolink/vocab/related_to_at_instance_level
<https://w3id.org/biolink/vocab/related_to_at_instance_level> rdf:type owl:ObjectProperty ;
                                                              rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to> ;
                                                              rdf:type owl:SymmetricProperty ;
                                                              rdfs:label "related to at instance level" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "Represents a relationship held between two instances of a data classes.  Much like an assertion component, in an ABox, these represent facts associated with the conceptual model." ;
                                                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                                              <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


###  https://w3id.org/biolink/vocab/taxon_of
<https://w3id.org/biolink/vocab/taxon_of> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                          rdfs:domain <https://w3id.org/biolink/vocab/OrganismTaxon> ;
                                          rdfs:range <https://w3id.org/biolink/vocab/ThingWithTaxon> ;
                                          rdfs:label "taxon of" ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/linkml/mixins
<https://w3id.org/linkml/mixins> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/mvikg/alt
<http://example.org/mvikg/alt> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                               rdfs:range xsd:string ;
                               rdfs:label "alternate allele" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The alternate (variant) allele observed at a given sequence position." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                               <http://www.w3.org/2004/02/skos/core#note> "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl." .


###  http://example.org/mvikg/comparedTo
<http://example.org/mvikg/comparedTo> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/biolink/vocab/PhenotypicFeature> ;
                                      rdfs:range xsd:string ;
                                      rdfs:label "compared to" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A free-text description of the baseline or control a phenotype outcome was compared against." ;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                      <http://www.w3.org/2004/02/skos/core#note> "Free-text description of the baseline/control a phenotype outcome was compared against. Domain (biolink:PhenotypicFeature) is external — see mvikg-restrictions.ttl." .


###  http://example.org/mvikg/effect
<http://example.org/mvikg/effect> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                  rdfs:range xsd:string ;
                                  rdfs:label "variant effect" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "A free-text description of the functional effect of a sequence variant, as reported in the source." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                  <http://www.w3.org/2004/02/skos/core#note> "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl." .


###  http://example.org/mvikg/frequencyValue
<http://example.org/mvikg/frequencyValue> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                          rdfs:range xsd:decimal ;
                                          rdfs:label "frequency value" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The numeric frequency value of a sequence variant or allele within a population; interpreted together with mvikg:frequencyUnit." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                          <http://www.w3.org/2004/02/skos/core#note> "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl." .


###  http://example.org/mvikg/has_biome_text
<http://example.org/mvikg/has_biome_text> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <http://www.w3.org/ns/sosa/Sample>
                                                                      <https://w3id.org/biolink/vocab/OrganismTaxon>
                                                                    )
                                                      ] ;
                                          rdfs:range xsd:string ;
                                          rdfs:label "has_biome_text" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Free-text description of a sample or organism taxon's environmental biome, used when the source text could not be mapped to a controlled GOLD biome term. If a value was normalized into mvikg:has_biome_term, the original text should still be retained here for provenance." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                          <http://www.w3.org/2004/02/skos/core#note> "Dual-predicate split of the former single-valued mvikg:has_biome, per the Case A (IRI-or-free-text) pattern." .


###  http://example.org/mvikg/length
<http://example.org/mvikg/length> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                  rdfs:range xsd:string ;
                                  rdfs:label "variant length" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "The length of a sequence variant." ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                  <http://www.w3.org/2004/02/skos/core#note> "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl." ,
                                                                             "Free-text length string — not all source rows give a clean integer." .


###  http://example.org/mvikg/ref
<http://example.org/mvikg/ref> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                               rdfs:range xsd:string ;
                               rdfs:label "reference allele" ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The reference allele reported at a given sequence position, prior to the observed variant." ;
                               <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                               <http://www.w3.org/2004/02/skos/core#note> "Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl." .


###  https://w3id.org/biolink/vocab/base_coordinate
<https://w3id.org/biolink/vocab/base_coordinate> rdf:type owl:DatatypeProperty ;
                                                 rdfs:subPropertyOf <https://w3id.org/biolink/vocab/sequence_localization_attribute> ;
                                                 rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                                 rdfs:range xsd:integer ;
                                                 rdfs:label "base coordinate" ;
                                                 <http://www.w3.org/2004/02/skos/core#altLabel> "fully-closed" ,
                                                                                                "one-based" ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A position in the base coordinate system.  Base coordinates start at position 1 instead of position 0." ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/category
<https://w3id.org/biolink/vocab/category> rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf <https://w3id.org/biolink/vocab/type> ;
                                          rdfs:domain <https://w3id.org/biolink/vocab/Entity> ;
                                          rdfs:range xsd:anyURI ;
                                          rdfs:label "category" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Name of the high level ontology class in which this entity is categorized. Corresponds to the label for the biolink entity type class. In a neo4j database this MAY correspond to the neo4j label tag. In an RDF database it should be a biolink model class URI. This field is multi-valued. It should include values for ancestors of the biolink class; for example, a protein such as Shh would have category values `biolink:Protein`, `biolink:GeneProduct`, `biolink:MolecularEntity`. In an RDF database, nodes will typically have an rdf:type triples. This can be to the most specific biolink class, or potentially to a class more specific than something in biolink. For example, a sequence feature `f` may have a rdf:type assertion to a SO class such as TF_binding_site, which is more specific than anything in biolink. Here we would have categories {biolink:GenomicEntity, biolink:MolecularEntity, biolink:NamedThing}" ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/description
<https://w3id.org/biolink/vocab/description> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/biolink/vocab/Entity> ;
                                             rdfs:range xsd:string ;
                                             rdfs:label "description" ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> "definition" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "a human-readable description of an entity" ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/IAO_0000115> ,
                                                                                              <http://www.w3.org/2004/02/skos/core#definitions> ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                             <http://www.w3.org/2004/02/skos/core#narrowMatch> <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#Description> .


###  https://w3id.org/biolink/vocab/end_coordinate
<https://w3id.org/biolink/vocab/end_coordinate> rdf:type owl:DatatypeProperty ;
                                                rdfs:subPropertyOf <https://w3id.org/biolink/vocab/base_coordinate> ;
                                                rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                                rdfs:range xsd:integer ;
                                                rdfs:label "end coordinate" ;
                                                <http://www.w3.org/2004/02/skos/core#altLabel> "end" ;
                                                <http://www.w3.org/2004/02/skos/core#closeMatch> <http://biohackathon.org/resource/faldo#end> ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "The position at which the subject genomic entity ends on the chromosome or other entity to which it is located on." ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#end> ;
                                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/id
<https://w3id.org/biolink/vocab/id> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/biolink/vocab/Entity> ;
                                    rdfs:range xsd:anyURI ;
                                    rdfs:label "id" ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A unique identifier for an entity. Must be either a CURIE shorthand for a URI or a complete URI" ;
                                    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#ID> ,
                                                                                     <https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_ID> ,
                                                                                     <https://www.alliancegenome.org/primaryId> ;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/publication_type
<https://w3id.org/biolink/vocab/publication_type> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <https://w3id.org/biolink/vocab/Publication> ;
                                                  rdfs:range xsd:anyURI ;
                                                  rdfs:label "publication type" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Ontology term for publication type may be drawn from Dublin Core types (https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/), FRBR-aligned Bibliographic Ontology (https://sparontologies.github.io/fabio/current/fabio.html), the MESH publication types (https://www.nlm.nih.gov/mesh/pubtypes.html), the Confederation of Open Access Repositories (COAR) Controlled Vocabulary for Resource Type Genres (http://vocabularies.coar-repositories.org/documentation/resource_types/), Wikidata (https://www.wikidata.org/wiki/Wikidata:Publication_types), or equivalent publication type ontology. When a given publication type ontology term is used within a given knowledge graph, then the CURIE identified term must be documented in the graph as a concept node of biolink:category biolink:OntologyClass." ;
                                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/published_in
<https://w3id.org/biolink/vocab/published_in> rdf:type owl:DatatypeProperty ;
                                              rdfs:range xsd:anyURI .


###  https://w3id.org/biolink/vocab/sequence_localization_attribute
<https://w3id.org/biolink/vocab/sequence_localization_attribute> rdf:type owl:DatatypeProperty ;
                                                                 rdfs:label "sequence localization attribute" ;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "An attribute that can be applied to a genome sequence localization edge. These edges connect a nucleic acid entity such as an exon to an entity such as a chromosome. Edge properties are used to ascribe specific positional information and other metadata to the localization. In pragmatic terms this can be thought of as columns in a GFF3 line." ;
                                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/start_coordinate
<https://w3id.org/biolink/vocab/start_coordinate> rdf:type owl:DatatypeProperty ;
                                                  rdfs:subPropertyOf <https://w3id.org/biolink/vocab/base_coordinate> ;
                                                  rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                                  rdfs:range xsd:integer ;
                                                  rdfs:label "start coordinate" ;
                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "start" ;
                                                  <http://www.w3.org/2004/02/skos/core#closeMatch> <http://biohackathon.org/resource/faldo#begin> ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "The position at which the subject genomic entity starts on the chromosome or other entity to which it is located on. (ie: the start of the sequence being referenced is 1)." ;
                                                  <http://www.w3.org/2004/02/skos/core#exactMatch> <https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#start> ;
                                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/type
