@prefix : <http://example.org/mvikg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/mvikg#> .

<http://example.org/mvikg> rdf:type owl:Ontology ;
                            owl:versionIRI <http://example.org/mvikg/0.0.1> ;
                            <http://purl.org/dc/terms/creator> "MVIKG" ;
                            <http://purl.org/dc/terms/description> "An integrated ontology combining BioLink, SOSA, ENVO, RO, GOLD and other established ontologies for bacterial variant data modeling" ;
                            <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                            <http://purl.org/dc/terms/title> "MVIKG: Multi-Variant Integration Knowledge Graph" ;
                            rdfs:comment "A schema for bacterial genotype-phenotype data integration" ;
                            rdfs:label "MVIKG Ontology" ;
                            owl:versionInfo "0.0.1" .

