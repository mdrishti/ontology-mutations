#################################################################
#    Object Properties
#################################################################

###  http://example.org/mvikg/has_biome
<http://example.org/mvikg/has_biome> rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <http://www.w3.org/ns/sosa/Sample>
                                                                 <https://w3id.org/biolink/vocab/OrganismTaxon>
                                                               )
                                                 ] ;
                                     rdfs:comment "Relates a sample or organism taxon to its environmental biome — either a resolved GOLD biome resource or, when the source text doesn't map to a controlled term, a free-text literal." ;
                                     rdfs:label "has biome" .


###  http://example.org/mvikg/has_developmental_stage
<http://example.org/mvikg/has_developmental_stage> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.w3.org/ns/sosa/Sample> ;
                                                   rdfs:range <http://example.org/mvikg/DevelopmentalStage> ;
                                                   rdfs:label "has developmental stage" .


###  http://purl.obolibrary.org/obo/ECO_9000000
<http://purl.obolibrary.org/obo/ECO_9000000> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://purl.obolibrary.org/obo/ECO_9000001> ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                             rdfs:range <http://purl.obolibrary.org/obo/ECO_0000217> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A relation connecting an evidence type to an assertion method where the assertion method describes the type of process employed to evaluate the evidence." ;
                                             <http://www.geneontology.org/formats/oboInOwl#created_by> "mchibucos" ;
                                             <http://www.geneontology.org/formats/oboInOwl#creation_date> "2010-12-09T05:00:20Z" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:9000000" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "eco" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "used_in" ;
                                             <http://www.geneontology.org/formats/oboInOwl#shorthand> "used_in" ;
                                             rdfs:comment "In the future we may use a more generic relation with weaker domain and range constraints taken from IAO, RO or OBI." ;
                                             rdfs:label "used_in" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/ECO_9000000> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "A relation connecting an evidence type to an assertion method where the assertion method describes the type of process employed to evaluate the evidence." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:SN"
 ] .


###  http://purl.obolibrary.org/obo/ECO_9000001
<http://purl.obolibrary.org/obo/ECO_9000001> rdf:type owl:ObjectProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A relation that is an inverse of \"used_in\" relation." ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:9000001" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "eco" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "uses" ;
                                             <http://www.geneontology.org/formats/oboInOwl#shorthand> "uses" ;
                                             rdfs:label "uses" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/ECO_9000001> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "A relation that is an inverse of \"used_in\" relation." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:SN"
 ] .


