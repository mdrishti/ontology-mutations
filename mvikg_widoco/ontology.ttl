#################################################################
#    Object Properties
#################################################################

###  http://example.org/mvikg/frequencyUnit
<http://example.org/mvikg/frequencyUnit> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                         rdfs:range [ rdf:type owl:Class ;
                                                      owl:oneOf ( <http://qudt.org/vocab/unit/PERCENT>
                                                                  <http://qudt.org/vocab/unit/UNITLESS>
                                                                )
                                                    ] ;
                                         rdfs:label "frequency unit" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "The unit — percent or unitless — in which a sequence variant's mvikg:frequencyValue is expressed." .


###  http://example.org/mvikg/has_biome_term
<http://example.org/mvikg/has_biome_term> rdf:type owl:ObjectProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <http://www.w3.org/ns/sosa/Sample>
                                                                      <https://w3id.org/biolink/vocab/OrganismTaxon>
                                                                    )
                                                      ] ;
                                          rdfs:range <http://example.org/mvikg/Biome> ;
                                          rdfs:label "has_biome_term" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Relates a sample or organism taxon to a resolved, curated biome term (typically from GOLD). Use mvikg:has_biome_text instead when the source text does not map to a controlled term." ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                          <http://www.w3.org/2004/02/skos/core#note> "Dual-predicate split of the former single-valued mvikg:has_biome, per the Case A (IRI-or-free-text) pattern." .


###  http://example.org/mvikg/has_developmental_stage
<http://example.org/mvikg/has_developmental_stage> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.w3.org/ns/sosa/Sample> ;
                                                   rdfs:range <http://example.org/mvikg/DevelopmentalStage> ;
                                                   rdfs:label "has developmental stage" ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a sample to the developmental stage (e.g. exponential, lag) of the organism it was taken from." ;
                                                   <http://www.w3.org/2004/02/skos/core#inScheme> <http://example.org/mvikg/linkml> ;
                                                   <http://www.w3.org/2004/02/skos/core#note> "Domain (sosa:Sample) is external — see mvikg-restrictions.ttl. No inverse declared (same resolution as frequencyUnit)." .


###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf <http://www.w3.org/2004/02/skos/core#narrower> ;
                                              <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#descriptionAnnot> "Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy ." ;
                                              rdfs:label "broader term"@en-us .


###  http://www.w3.org/2004/02/skos/core#narrower
<http://www.w3.org/2004/02/skos/core#narrower> rdf:type owl:ObjectProperty ;
                                               <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#descriptionAnnot> "Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy ." ;
                                               rdfs:label "narrower term"@en-us .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                 rdfs:domain <http://www.w3.org/ns/sosa/Sample> ;
                                                 rdfs:range <https://w3id.org/biolink/vocab/GenomicEntity> ;
                                                 <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Actuation> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ;
                                                 <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                 rdfs:comment "A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled."@en ;
                                                 rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                                 rdfs:label "has feature of interest"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled."@en ;
                                                 <http://www.w3.org/2004/02/skos/core#example> "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."@en .


###  http://www.w3.org/ns/sosa/hasSample
<http://www.w3.org/ns/sosa/hasSample> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://www.w3.org/ns/sosa/isSampleOf> ;
                                      rdf:type owl:InverseFunctionalProperty ;
                                      rdfs:domain <https://w3id.org/biolink/vocab/OrganismTaxon> ;
                                      rdfs:range <http://www.w3.org/ns/sosa/Sample> ;
                                      <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Sample> ;
                                      rdfs:comment "Relation between a FeatureOfInterest and the Sample used to represent it."@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                      rdfs:label "has sample"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Relation between a FeatureOfInterest and the Sample used to represent it."@en .


###  http://www.w3.org/ns/sosa/isFeatureOfInterestOf
<http://www.w3.org/ns/sosa/isFeatureOfInterestOf> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/biolink/vocab/GenomicEntity> ;
                                                  rdfs:range <http://www.w3.org/ns/sosa/Sample> ;
                                                  <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                  <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Actuation> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ;
                                                  rdfs:comment "A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it."@en ;
                                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                                  rdfs:label "is feature of interest of"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it."@en .


###  http://www.w3.org/ns/sosa/isSampleOf
<http://www.w3.org/ns/sosa/isSampleOf> rdf:type owl:ObjectProperty ,
                                                owl:FunctionalProperty ;
                                       rdfs:domain <http://www.w3.org/ns/sosa/Sample> ;
                                       rdfs:range <https://w3id.org/biolink/vocab/OrganismTaxon> ;
                                       <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Sample> ;
                                       rdfs:comment "Relation from a Sample to the FeatureOfInterest that it is intended to be representative of."@en ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                       rdfs:label "is sample of"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Relation from a Sample to the FeatureOfInterest that it is intended to be representative of."@en .


###  https://w3id.org/biolink/vocab/has_evidence
<https://w3id.org/biolink/vocab/has_evidence> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/biolink/vocab/PhenotypicFeature> ;
                                              rdfs:range [ rdf:type owl:Class ;
                                                           owl:oneOf ( <http://purl.obolibrary.org/obo/ECO_0000035>
                                                                       <http://purl.obolibrary.org/obo/ECO_0000305>
                                                                     )
                                                         ] ;
                                              rdfs:label "has evidence" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Connects a phenotypic feature assertion to the type of evidence (ECO) supporting it." .


###  https://w3id.org/biolink/vocab/has_phenotype
<https://w3id.org/biolink/vocab/has_phenotype> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                               owl:inverseOf <https://w3id.org/biolink/vocab/phenotype_of> ;
                                               rdfs:domain [ rdf:type owl:Class ;
                                                             owl:unionOf ( <http://www.w3.org/ns/sosa/Sample>
                                                                           <https://w3id.org/biolink/vocab/Gene>
                                                                           <https://w3id.org/biolink/vocab/GenomicEntity>
                                                                           <https://w3id.org/biolink/vocab/SequenceVariant>
                                                                         )
                                                           ] ;
                                               rdfs:range <https://w3id.org/biolink/vocab/PhenotypicFeature> ;
                                               rdfs:label "has phenotype" ;
                                               <http://www.w3.org/2004/02/skos/core#altLabel> "disease presents symptom" ;
                                               <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.obolibrary.org/obo/NCIT_R108> ,
                                                                                                <http://purl.obolibrary.org/obo/NCIT_R115> ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "holds between a biological entity and a phenotype, where a phenotype is construed broadly as any kind of quality of an organism part, a collection of these qualities, or a change in quality or qualities (e.g. abnormally increased temperature). In SNOMEDCT, disorders with keyword 'characterized by' should translate into this predicate." ;
                                               <http://www.w3.org/2004/02/skos/core#editorialNote> "check the range" ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/RO_0002200> ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                               <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/NCIT_R89> ,
                                                                                                 <http://purl.obolibrary.org/obo/RO_0004022> ,
                                                                                                 <http://purl.obolibrary.org/obo/RO_0004029> ,
                                                                                                 <http://purl.obolibrary.org/obo/doid#has_symptom> ;
                                               <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


###  https://w3id.org/biolink/vocab/has_sequence_variant
<https://w3id.org/biolink/vocab/has_sequence_variant> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                                      owl:inverseOf <https://w3id.org/biolink/vocab/is_sequence_variant_of> ;
                                                      rdfs:domain <https://w3id.org/biolink/vocab/GenomicEntity> ;
                                                      rdfs:range <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                                      rdfs:label "has sequence variant" ;
                                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/in_taxon
<https://w3id.org/biolink/vocab/in_taxon> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                          owl:inverseOf <https://w3id.org/biolink/vocab/taxon_of> ;
                                          rdfs:domain <https://w3id.org/biolink/vocab/ThingWithTaxon> ;
                                          rdfs:range <https://w3id.org/biolink/vocab/OrganismTaxon> ;
                                          rdfs:label "in taxon" ;
                                          <http://www.w3.org/2004/02/skos/core#altLabel> "gene found in organism" ,
                                                                                         "gene product has organism source" ,
                                                                                         "instance of" ,
                                                                                         "is organism source of gene product" ,
                                                                                         "organism has gene" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "connects an entity to its taxonomic classification. Only certain kinds of entities can be taxonomically classified; see 'thing with taxon'" ;
                                          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/RO_0002162> ,
                                                                                           <https://www.wikidata.org/prop/P703> ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                          <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/RO_0002160> ;
                                          <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


###  https://w3id.org/biolink/vocab/is_sequence_variant_of
<https://w3id.org/biolink/vocab/is_sequence_variant_of> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                                        rdfs:domain <https://w3id.org/biolink/vocab/SequenceVariant> ;
                                                        rdfs:range <https://w3id.org/biolink/vocab/GenomicEntity> ;
                                                        rdfs:label "is sequence variant of" ;
                                                        <http://www.w3.org/2004/02/skos/core#altLabel> "allelic variant of" ,
                                                                                                       "gene product sequence variation encoded by gene mutant" ,
                                                                                                       "gene product variant of gene product" ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "holds between a sequence variant and a nucleic acid entity" ;
                                                        <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                                        <http://www.w3.org/2004/02/skos/core#narrowMatch> <https://www.wikidata.org/entity/P3433> ;
                                                        <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


