                                                            rdfs:label "preventative for condition" ;
                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "prevents" ,
                                                                                                           "prophylactic for" ;
                                                            <http://www.w3.org/2004/02/skos/core#broadMatch> <https://skr3.nlm.nih.gov/SemMedDBPREVENTS> ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Holds between a substance, procedure, or activity and a medical condition (disease or phenotypic feature), and states that the  substance, procedure, or activity is able to prevent it manifesting in the first place." ;
                                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                                            <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


