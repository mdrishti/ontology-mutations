                                                            rdfs:label "physical essence or occurrent" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Either a physical or processual entity." ;
                                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/SequenceVariant
<https://w3id.org/biolink/vocab/SequenceVariant> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/biolink/vocab/BiologicalEntity> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/linkml/mixins> ;
                                                                   owl:someValuesFrom <https://w3id.org/biolink/vocab/GenomicEntity>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/linkml/mixins> ;
                                                                   owl:someValuesFrom <https://w3id.org/biolink/vocab/OntologyClass>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/linkml/mixins> ;
                                                                   owl:someValuesFrom <https://w3id.org/biolink/vocab/PhysicalEssence>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/biolink/vocab/has_gene> ;
                                                                   owl:allValuesFrom <https://w3id.org/biolink/vocab/Gene>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/biolink/vocab/id> ;
                                                                   owl:allValuesFrom xsd:string
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/biolink/vocab/id> ;
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/biolink/vocab/id> ;
                                                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                 ] ;
                                                 rdfs:comment "In MVIKG: A genomic variant associated with a specific gene" ;
                                                 rdfs:label "sequence variant" ;
                                                 <http://www.w3.org/2004/02/skos/core#altLabel> "allele" ;
                                                 <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/GENO_0000002> ,
                                                                                                  <http://purl.obolibrary.org/obo/SO_0001060> ,
                                                                                                  <http://semanticscience.org/resource/SIO_010277> ,
                                                                                                  <https://datacommons.org/browser/Allele> ,
                                                                                                  <https://github.com/ga4gh/vr-spec/Allele> ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A sequence_variant is a non exact copy of a sequence_feature or genome exhibiting one or more sequence_alteration." ;
                                                 <http://www.w3.org/2004/02/skos/core#exactMatch> <https://www.wikidata.org/entity/Q15304597> ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                                 <http://www.w3.org/2004/02/skos/core#note> "This class is for modeling the specific state at a locus. A single DBSNP rs ID could correspond to more than one sequence variants (e.g CIViC:1252 and CIViC:1253, two distinct BRCA2 alleles for rs28897743)" .


###  https://w3id.org/biolink/vocab/ThingWithTaxon
<https://w3id.org/biolink/vocab/ThingWithTaxon> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/linkml/ClassDefinition#Mixin> ;
                                                rdfs:label "thing with taxon" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A mixin that can be used on any entity that can be taxonomically classified. This includes individual organisms; genes, their products and other molecular entities; body parts; biological processes" ;
                                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


