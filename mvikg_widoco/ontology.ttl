###  https://w3id.org/biolink/vocab/related_to_at_instance_level
<https://w3id.org/biolink/vocab/related_to_at_instance_level> rdf:type owl:ObjectProperty ;
                                                              rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to> ;
                                                              rdf:type owl:SymmetricProperty ;
                                                              rdfs:label "related to at instance level" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "Represents a relationship held between two instances of a data classes.  Much like an assertion component, in an ABox, these represent facts associated with the conceptual model." ;
                                                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> ;
                                                              <https://w3id.org/biolink/vocab/canonical_predicate> "true"^^xsd:boolean .


###  https://w3id.org/biolink/vocab/subject
<https://w3id.org/biolink/vocab/subject> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/biolink/vocab/Association> ;
                                         rdfs:range <https://w3id.org/biolink/vocab/NamedThing> ;
                                         rdfs:label "subject" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "connects an association to the subject of the association. For example, in a gene-to-phenotype association, the gene is subject and phenotype is object." ;
                                         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.org/oban/association_has_subject> ,
                                                                                          owl:annotatedSource ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


###  https://w3id.org/biolink/vocab/taxon_of
<https://w3id.org/biolink/vocab/taxon_of> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf <https://w3id.org/biolink/vocab/related_to_at_instance_level> ;
                                          rdfs:domain <https://w3id.org/biolink/vocab/OrganismTaxon> ;
                                          rdfs:range <https://w3id.org/biolink/vocab/ThingWithTaxon> ;
                                          rdfs:label "taxon of" ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


