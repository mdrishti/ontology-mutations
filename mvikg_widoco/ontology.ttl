###  https://w3id.org/biolink/vocab/VariantToGeneAssociation
<https://w3id.org/biolink/vocab/VariantToGeneAssociation> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/biolink/vocab/Association> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/linkml/mixins> ;
                                                                            owl:someValuesFrom <https://w3id.org/biolink/vocab/VariantToEntityAssociationMixin>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/object> ;
                                                                            owl:allValuesFrom <https://w3id.org/biolink/vocab/Gene>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/object> ;
                                                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/object> ;
                                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/predicate> ;
                                                                            owl:allValuesFrom xsd:string
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/predicate> ;
                                                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/biolink/vocab/predicate> ;
                                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ;
                                                          rdfs:label "variant to gene association" ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "An association between a variant and a gene, where the variant has a genetic association with the gene (i.e. is in linkage disequilibrium)" ;
                                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/biolink-model> .


