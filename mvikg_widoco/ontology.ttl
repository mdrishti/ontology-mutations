###  http://example.org/mvikg/Biome
<http://example.org/mvikg/Biome> rdf:type owl:Class ;
                                 rdfs:label "Biome" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "A biome classification describing a sample's environmental context, typically drawn from the GOLD biome vocabulary." ;
