                                                  <http://purl.org/dc/terms/description> "The property \"vaem:revision\" is a property intended for general use as the name implies." ;
                                                  rdfs:isDefinedBy <http://www.linkedmodel.org/2.0/schema/vaem> ,
                                                                   <http://www.linkedmodel.org/schema/vaem> ;
                                                  rdfs:label "revision" .


