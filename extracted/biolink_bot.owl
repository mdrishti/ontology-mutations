<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/biolink/biolink-model.owl.ttl#"
     xml:base="https://w3id.org/biolink/biolink-model.owl.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/biolink/vocab/"
     xmlns:linkml="https://w3id.org/linkml/">
    <owl:Ontology rdf:about="https://w3id.org/biolink/biolink-model.owl.ttl">
        <terms:description>Extracted ontology classes and properties from BioLink</terms:description>
        <terms:license>https://creativecommons.org/publicdomain/zero/1.0/</terms:license>
        <terms:source>BioLink Model</terms:source>
        <terms:title>BioLink Ontology (Extracted)</terms:title>
        <pav:version>4.3.4</pav:version>
        <rdfs:comment>Extracted biolink terms</rdfs:comment>
        <rdfs:label>Biolink-Model</rdfs:label>
        <skos:definition>Entity and association taxonomy and datamodel for life-sciences data</skos:definition>
    </owl:Ontology>



