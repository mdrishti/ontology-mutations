    <!-- http://www.linkedmodel.org/schema/vaem#url -->

    <owl:DatatypeProperty rdf:about="http://www.linkedmodel.org/schema/vaem#url">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:description>The property &quot;vaem:url&quot; is intended for general use as the name implies.  The range of the property is set as an XSD URI</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label>url</rdfs:label>
    </owl:DatatypeProperty>



    <!--
