        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <rdfs:label>applicable system</rdfs:label>
    </owl:NamedIndividual>



    <!-- http://qudt.org/schema/qudt/code -->

