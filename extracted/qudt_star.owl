        <rdfs:label>Signed</rdfs:label>
    </owl:NamedIndividual>



    <!-- http://qudt.org/schema/qudt/ScaleType -->

    <owl:NamedIndividual rdf:about="http://qudt.org/schema/qudt/ScaleType">
        <qudt:plainTextDescription>Scales, or scales of measurement (or categorization) provide ways of quantifying measurements, values and other enumerated values according to a normative frame of reference.  Four different types of scales are typically used. These are interval, nominal, ordinal and ratio scales.</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <rdfs:label>Scale type</rdfs:label>
    </owl:NamedIndividual>



