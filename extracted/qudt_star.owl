    <owl:DatatypeProperty rdf:about="http://www.linkedmodel.org/schema/vaem#previousPublishedVersion">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:description>The property &quot;vaem:previousPublishedVersion&quot;is a URL to documentation for the previous version of a graph.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label>previous published version</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.linkedmodel.org/schema/vaem#rdfxmlFileURL -->

    <owl:DatatypeProperty rdf:about="http://www.linkedmodel.org/schema/vaem#rdfxmlFileURL">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:description>The property &quot;vaem:rdfxmlFileURL&quot; is used to provide a link to the location of the ontology&apos;s RDF/XML file</terms:description>
