     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:dtype="http://www.linkedmodel.org/schema/dtype#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://qudt.org/2.1/schema/qudt">
        <terms:description>Extracted classifications from the Quantities, Units, Dimensions and Types (QUDT) schema and unit vocabularies</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:title>QUDT Ontology (Extracted)</terms:title>
        <vaem:hasGraphMetadata rdf:resource="http://www.linkedmodel.org/schema/vaem#GMD_QUDT-SCHEMA"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <rdfs:label>QUDT Schema - Version 2.1.47</rdfs:label>
    </owl:Ontology>



