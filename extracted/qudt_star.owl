        <vaem:isMetadataFor rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <vaem:logo rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png</vaem:logo>
        <vaem:usesNonImportedResource rdf:resource="http://purl.org/dc/terms/abstract"/>
        <vaem:usesNonImportedResource rdf:resource="http://purl.org/dc/terms/contributor"/>
