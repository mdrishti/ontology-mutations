        <rdfs:label>RDF/XML file URL</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.linkedmodel.org/schema/vaem#revision -->

    <owl:DatatypeProperty rdf:about="http://www.linkedmodel.org/schema/vaem#revision">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:description>The property &quot;vaem:revision&quot; is a property intended for general use as the name implies.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label>revision</rdfs:label>
