    <owl:ObjectProperty rdf:about="http://www.linkedmodel.org/schema/vaem#hasLicenseType">
        <terms:description>The property &quot;vaem:hasLicenseType&quot; points to an entry in the VOAG ontology for licenses</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label xml:lang="en-us">has license type</rdfs:label>
    </owl:ObjectProperty>



