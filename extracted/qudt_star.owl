    <!-- http://www.linkedmodel.org/schema/vaem#hasGraphRole -->

    <owl:ObjectProperty rdf:about="http://www.linkedmodel.org/schema/vaem#hasGraphRole">
        <rdfs:range rdf:resource="http://www.linkedmodel.org/schema/vaem#GraphRole"/>
        <terms:description>The property &quot;lms:hasGraphRole&quot; is used to characterize how a resource participates in an ontology set.  The property is used to specify the role that a graph plays, for example, an ontology graph can be a schema, vocabulary, dataset, script, or ruleset</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label>has graph role</rdfs:label>
    </owl:ObjectProperty>



