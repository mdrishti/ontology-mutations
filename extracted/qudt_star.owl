        <terms:description>The property &quot;vaem:turtleFileURL&quot; is used to provide a link to the location of the ontology&apos;s turtle file</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
