    </owl:NamedIndividual>



    <!-- http://qudt.org/schema/qudt/BooleanEncoding -->

    <owl:NamedIndividual rdf:about="http://qudt.org/schema/qudt/BooleanEncoding">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/BooleanEncodingType"/>
        <qudt:bits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</qudt:bits>
