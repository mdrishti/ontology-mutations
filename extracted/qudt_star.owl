    <!-- http://www.linkedmodel.org/schema/vaem#hasSteward -->

    <owl:ObjectProperty rdf:about="http://www.linkedmodel.org/schema/vaem#hasSteward">
        <terms:description>A property that is used to refer to a &quot;Steward&quot;, that is, the party or role that is responsible for maintaining an asset, in the case of VAEM, an ontology graph.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/2.0/schema/vaem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.linkedmodel.org/schema/vaem"/>
        <rdfs:label>has steward</rdfs:label>
    </owl:ObjectProperty>



