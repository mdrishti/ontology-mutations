        <oboInOwl:id>ECO:0000217</oboInOwl:id>
        <rdfs:label>assertion method</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000217"/>
