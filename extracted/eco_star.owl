     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/eco.owl">
        <terms:description>Hand-declared subset of the Evidence and Conclusion Ontology</terms:description>
        <terms:license>https://creativecommons.org/publicdomain/zero/1.0/</terms:license>
        <terms:title>ECO Ontology (Extracted)</terms:title>
    </owl:Ontology>



