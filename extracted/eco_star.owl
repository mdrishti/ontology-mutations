    <!-- http://purl.obolibrary.org/obo/ECO_0000035 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/ECO_0000035">
        <rdfs:label xml:lang="en">no evidence data found</rdfs:label>
        <skos:definition xml:lang="en">A type of curator inference that results when research finds no evidence information in the scientific literature, at reference databases, or from other resources.</skos:definition>
    </owl:NamedIndividual>



    <!-- http://purl.obolibrary.org/obo/ECO_0000305 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/ECO_0000305">
        <rdfs:label xml:lang="en">curator inference used in manual assertion</rdfs:label>
        <skos:definition xml:lang="en">A type of curator inference used when a curator reviewed the literature and made a manual evidence assertion.</skos:definition>
    </owl:NamedIndividual>
</rdf:RDF>



