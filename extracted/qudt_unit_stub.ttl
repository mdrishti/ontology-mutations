@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# qudt:Unit declared by hand rather than via robot extract: it's entangled
# in QUDT's own self-describing meta-model (encoding/cardinality/ordering
# types, graph-role documentation individuals) via shared axioms, so a
# BOT or STAR module for just this one class pulls in dozens of unrelated
# classes from qudt-schema.ttl. We only need the bare class identity so
# unit:PERCENT/unit:UNITLESS below can be typed as qudt:Unit.
qudt:Unit a owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:comment "A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities of the same kind."@en .

# unit:PERCENT declared by hand rather than via robot extract: QUDT's
# vocab/unit.ttl is one densely interlinked graph (every unit points to
# quantitykind/, systemsOfUnits/, dimensionVector/ resources and back), so a
# STAR/BOT module extraction for a single individual pulls in most of the
# 2.3MB source file and trips robot's duplicate_label QC check thousands of
# times over unrelated multilingual labels elsewhere in the vocabulary. We
# only need the identity and label for the frequency unit MVIKG actually
# uses (rdfLibMVIKG src/kgBuilder{Xls,ClaudeSkills}.py, QUDTUNIT.PERCENT).
unit:PERCENT a owl:NamedIndividual, qudt:Unit ;
    rdfs:label "Percent"@en ;
    qudt:symbol "%" .

# unit:UNITLESS declared by hand for the same reason as unit:PERCENT above —
# used as the alternative mvikg:frequencyUnit value for a frequency reported
# without a percent (e.g. a raw ratio or count).
unit:UNITLESS a owl:NamedIndividual, qudt:Unit ;
    rdfs:label "Unitless"@en .
