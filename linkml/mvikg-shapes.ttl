@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix mvikg: <https://w3id.org/mvikg#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Hand-authored SHACL shapes for every mvikg property migrated to
# linkml/mvikg.yaml. Not auto-generated by `gen-shacl`: that tool only
# emits a NodeShape for a class if LinkML's schema attaches slots to it via
# `slots:` on the class, which requires LinkML to own the class -- the same
# implicit-domain-ownership limitation that keeps domains out of gen-owl's
# output (see mvikg-restrictions.ttl, NOTES.md item 15/16/17). Test fixtures
# live separately in linkml/mvikg-shapes-test-data.ttl, not here, so this
# file stays pure validation rules usable against the real build output.

mvikg:SampleBiomeShape a sh:NodeShape ;
    sh:targetClass sosa:Sample ;
    sh:property [
        sh:path mvikg:has_biome_term ;
        sh:class mvikg:Biome ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path mvikg:has_biome_text ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path mvikg:has_developmental_stage ;
        sh:class mvikg:DevelopmentalStage ;
        sh:nodeKind sh:IRI ;
    ] .

mvikg:OrganismTaxonBiomeShape a sh:NodeShape ;
    sh:targetClass biolink:OrganismTaxon ;
    sh:property [
        sh:path mvikg:has_biome_term ;
        sh:class mvikg:Biome ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path mvikg:has_biome_text ;
        sh:datatype xsd:string ;
    ] .

mvikg:PhenotypicFeatureShape a sh:NodeShape ;
    sh:targetClass biolink:PhenotypicFeature ;
    sh:property [
        sh:path mvikg:comparedTo ;
        sh:datatype xsd:string ;
    ] .

mvikg:SequenceVariantShape a sh:NodeShape ;
    sh:targetClass biolink:SequenceVariant ;
    sh:property [
        sh:path mvikg:ref ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path mvikg:alt ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path mvikg:length ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path mvikg:effect ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path mvikg:frequencyValue ;
        sh:datatype xsd:decimal ;
    ] .
