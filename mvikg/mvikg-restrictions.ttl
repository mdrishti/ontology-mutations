@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .

# mvikg:has_biome (formerly mvikg:has_habitat) intentionally has no
# owl:allValuesFrom restriction here: the KG builders fall back to a
# free-text xsd:string literal when source text doesn't map to a GOLD biome
# resource, and an allValuesFrom-to-mvikg:Biome restriction would make that
# case unsatisfiable. See mvikg-property-constraints.ttl.

# If a Sample has a developmental stage, it CAN ONLY be a mvikg:DevelopmentalStage
sosa:Sample rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty mvikg:has_developmental_stage ;
    owl:allValuesFrom mvikg:DevelopmentalStage
] .


# If a Sample is part of something, it CAN ONLY be a Dataset
sosa:Sample rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty dcterms:isPartOf ;
    owl:allValuesFrom dcmitype:Dataset
] .
