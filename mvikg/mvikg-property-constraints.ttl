@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix goldvocab: <https://w3id.org/gold.vocab/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ECO: <http://purl.obolibrary.org/obo/ECO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


# mvikg:has_biome retired from the ontology side (20261119) — superseded by
# mvikg:has_biome_term/has_biome_text (linkml/mvikg.yaml, Dual-Predicate
# pattern, see NOTES.md item 15). The rdfLibMVIKG KG builders
# (src/kgBuilder{Xls,BioC,ClaudeSkills}.py) still emit the old predicate as
# of this date — that Python-side migration is tracked separately, not here.

# mvikg:comparedTo, mvikg:ref, mvikg:alt, mvikg:length, mvikg:effect,
# mvikg:frequencyValue migrated to linkml/mvikg.yaml (generated via
# `gen-owl --no-use-native-uris` into mvikg/mvikg-generated.ttl, merged in
# build-mvikg.sh Step 2). Their domains (biolink:PhenotypicFeature /
# biolink:SequenceVariant — external classes) moved to mvikg-restrictions.ttl.
# See NOTES.md item 15/16.

mvikg:frequencyUnit rdf:type owl:ObjectProperty ;
    rdfs:label "frequency unit" ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range [ rdf:type owl:Class ; owl:oneOf ( unit:PERCENT unit:UNITLESS ) ] ;
    skos:definition "The unit — percent or unitless — in which a sequence variant's mvikg:frequencyValue is expressed." .

# mvikg:has_developmental_stage and mvikg:DevelopmentalStage migrated to
# linkml/mvikg.yaml. Domain (sosa:Sample) moved to mvikg-restrictions.ttl.
# No inverse declared (same resolution as frequencyUnit).
