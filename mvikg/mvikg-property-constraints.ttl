@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix goldvocab: <https://w3id.org/gold.vocab/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# Custom MVIKG properties (both restrictions and annotations)
# mvikg:has_biome can point to any GOLD biome (or their subclasses), or —
# when the source text doesn't map to a controlled term — a free-text
# xsd:string literal instead. Range intentionally left open (do not add an
# owl:allValuesFrom mvikg:Biome restriction here; see mvikg-restrictions.ttl).
# Renamed from mvikg:has_habitat to match the predicate the KG builders
# actually emit (rdfLibMVIKG src/kgBuilder{Xls,BioC,ClaudeSkills}.py).
mvikg:has_biome rdf:type owl:ObjectProperty ;
    rdfs:comment "Relates a sample or organism taxon to its environmental biome — either a resolved GOLD biome resource or, when the source text doesn't map to a controlled term, a free-text literal." ;
    rdfs:domain [ rdf:type owl:Class ;
                owl:unionOf ( sosa:Sample
			      biolink:OrganismTaxon
                            )
                ] ;
    rdfs:label "has biome" .

# mvikg:comparedTo — free-text description of the baseline/control a phenotype
# outcome was compared against (rdfLibMVIKG kgBuilderClaudeSkills.py:640)
mvikg:comparedTo rdf:type owl:DatatypeProperty ;
    rdfs:label "compared to" ;
    rdfs:comment "Free-text description of the baseline/control a phenotype outcome was compared against." ;
    rdfs:domain biolink:PhenotypicFeature ;
    rdfs:range xsd:string .

# Define that mvikg:has_developmental_stage relates a sample to a developmental stage. Initially taken from UNIPROTRDFS, that definition did not fit here, hence removed.
mvikg:has_developmental_stage rdf:type owl:ObjectProperty ;
    rdfs:domain sosa:Sample ;
    rdfs:range mvikg:DevelopmentalStage ;
    rdfs:label "has developmental stage" .



# Define that has_phenotype relates genes to phenotypes
biolink:has_phenotype
    rdfs:domain biolink:Gene ;
    rdfs:range biolink:PhenotypicFeature .



# Define domains and ranges for SOSA properties used in cross-links
sosa:hasFeatureOfInterest
    rdfs:domain biolink:GenomicEntity ;
    rdfs:range sosa:Sample .



sosa:hasSample
    rdfs:domain biolink:OrganismTaxon ;
    rdfs:range sosa:Sample .
