@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# mvikg:DevelopmentalStage and mvikg:Biome migrated to linkml/mvikg.yaml.
# (Biome's commented-out owl:equivalentClass/unionOf-to-GOLD block, never
# finalized, is preserved in git history at this file's prior revision, not
# carried into the LinkML source.)

# Add context-specific annotations to imported classes
sosa:Sample
    rdfs:comment "In MVIKG: A biological sample with genomic, environmental, and phenotypic metadata" ;
    skos:note "Samples are central to MVIKG, linking organisms, genomes, environments, and phenotypes" .

biolink:Gene
    rdfs:comment "In MVIKG: A gene that may have sequence variants and associated phenotypes" .

biolink:GenomicEntity
    rdfs:comment "In MVIKG: instances are minted per-record (scoped to document + organism + gene symbol), not shared across papers/organisms, to avoid collisions when the same gene symbol denotes different genes in different organisms. The canonical resolved gene identity is reachable one hop away via dcterms:identifier. The same per-record blank-node pattern applies to biolink:SequenceVariant and biolink:PhenotypicFeature instances." .

biolink:SequenceVariant
    rdfs:comment "In MVIKG: A genomic variant associated with a specific gene" .

biolink:PhenotypicFeature
    rdfs:comment "In MVIKG: An observable characteristic linked to genes" .

biolink:OrganismTaxon
    rdfs:comment "In MVIKG: The taxonomic classification of sampled organisms" .
