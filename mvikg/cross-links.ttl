@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix RO:    <http://purl.obolibrary.org/obo/RO_> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2008/05/skos#> .
@prefix ENVO:    <http://purl.obolibrary.org/obo/ENVO_> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix mvikg:    <http://example.org/mvikg/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .

# Mutation data modelling
sosa:Sample sosa:hasFeatureOfInterest biolink:GenomicEntity .
biolink:GenomicEntity sosa:isFeatureOfInterestOf sosa:Sample .
biolink:Gene rdf:type biolink:GenomicEntity .
biolink:SequenceVariant biolink:has_gene biolink:Gene .
biolink:SequenceVariant biolink:has_sequence_variant biolink:Gene .
biolink:Gene biolink:is_sequence_variant_of biolink:SequenceVariant .
biolink:Gene biolink:form_or_variant_qualifier biolink:VariantToGeneAssociation .

# Organism data modelling
sosa:Sample sosa:isSampleOf biolink:OrganismTaxon .
biolink:OrganismTaxon sosa:hasSample sosa:Sample .

# Sample-to-publication provenance: the paper a sample is mentioned in.
# Was modelled as sosa:Sample dcterms:isPartOf dcmitype:Dataset — wrong,
# a sample isn't part of a dataset, it's mentioned in a paper. Domain/range
# use biolink:Publication (not just biolink:Article) to cover all publication
# types (Article, Book, BookChapter, DrugLabel, Patent, PreprintPublication,
# Serial, WebPage) — see https://biolink.github.io/biolink-model/Publication/.
biolink:Publication biolink:mentions sosa:Sample .
sosa:Sample biolink:mentioned_by biolink:Publication .

# Linking from Mutation data modelling to Phenotype data modelling
biolink:Gene biolink:has_phenotype biolink:PhenotypicFeature .

# Sample to GOLD biome habitat relationship
# Changed from ENVO:01000254 to mvikg:GoldBiome
sosa:Sample RO:0002303 mvikg:GoldBiome .
    # RO:hasHabitat
    # mvikg:GoldBiome encompasses all GOLD biome classes

sosa:Sample mvikg:hasDevelopmentalStage mvikg:DevelopmentalStage .
