        <vaem:hasSteward rdf:resource="http://www.linkedmodel.org/schema/vaem#QUDT"/>
        <vaem:intent>Specifies the schema for quantities, units and dimensions. Types are defined in other schemas.</vaem:intent>
        <vaem:latestPublishedVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://qudt.org/doc/2025/01/DOC_SCHEMA-QUDT.html</vaem:latestPublishedVersion>
        <vaem:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/schema/qudt/</vaem:namespace>
        <vaem:namespacePrefix>qudt</vaem:namespacePrefix>
        <vaem:owner>qudt.org</vaem:owner>
        <vaem:previousPublishedVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://qudt.org/doc/2024/12/DOC_SCHEMA-QUDT.html</vaem:previousPublishedVersion>
        <vaem:turtleFileURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/2.1/schema/qudt</vaem:turtleFileURL>
