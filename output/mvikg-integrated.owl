        <rdfs:label>Single Precision Real Encoding</rdfs:label>
    </owl:NamedIndividual>



    <!-- http://qudt.org/schema/qudt/TotallyOrdered -->

    <owl:NamedIndividual rdf:about="http://qudt.org/schema/qudt/TotallyOrdered">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/OrderedType"/>
        <qudt:plainTextDescription>Totally ordered structure.</qudt:plainTextDescription>
        <dtype:literal>total</dtype:literal>
