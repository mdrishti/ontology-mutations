    <!-- http://www.linkedmodel.org/schema/vaem#GMD_VAEM -->

    <owl:NamedIndividual rdf:about="http://www.linkedmodel.org/schema/vaem#GMD_VAEM">
        <rdf:type rdf:resource="http://www.linkedmodel.org/schema/vaem#GraphMetaData"/>
