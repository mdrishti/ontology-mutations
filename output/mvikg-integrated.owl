        <dc:description>7 bits of 1 octet</dc:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <rdfs:label>Char Encoding</rdfs:label>
    </owl:NamedIndividual>



