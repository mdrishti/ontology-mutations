     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dtype="http://www.linkedmodel.org/schema/dtype#"
     xmlns:mvikg="http://example.org/mvikg/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vitro="http://vitro.mannlib.cornell.edu/ns/vitro/0.7#"
     xmlns:linkml="https://w3id.org/linkml/"
     xmlns:schema="http://schema.org/"
     xmlns:biolink="https://w3id.org/biolink/vocab/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://example.org/mvikg">
        <owl:versionIRI rdf:resource="http://example.org/mvikg/0.0.1"/>
        <terms:creator>MVIKG</terms:creator>
        <terms:description>An integrated ontology combining BioLink, SOSA, ENVO, RO, GOLD and other established ontologies for bacterial variant data modeling</terms:description>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:title>MVIKG: Multi-Variant Integration Knowledge Graph</terms:title>
        <rdfs:comment>A schema for bacterial genotype-phenotype data integration</rdfs:comment>
        <rdfs:label>MVIKG Ontology</rdfs:label>
        <owl:versionInfo>0.0.1</owl:versionInfo>
    </owl:Ontology>



