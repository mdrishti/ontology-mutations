    <!-- http://example.org/mvikg/frequency -->

    <owl:ObjectProperty rdf:about="http://example.org/mvikg/frequency">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment>Points to a qudt:QuantityValue node (numericValue + unit, typically percent).</rdfs:comment>
        <rdfs:label>frequency</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://example.org/mvikg/has_biome -->

    <owl:ObjectProperty rdf:about="http://example.org/mvikg/has_biome">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/OrganismTaxon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment>Relates a sample or organism taxon to its environmental biome — either a resolved GOLD biome resource or, when the source text doesn&apos;t map to a controlled term, a free-text literal.</rdfs:comment>
        <rdfs:label>has biome</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://example.org/mvikg/has_developmental_stage -->

    <owl:ObjectProperty rdf:about="http://example.org/mvikg/has_developmental_stage">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:range rdf:resource="http://example.org/mvikg/DevelopmentalStage"/>
        <rdfs:label>has developmental stage</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://purl.obolibrary.org/obo/ECO_9000000 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/ECO_9000000">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/ECO_9000001"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ECO_0000217"/>
        <obo:IAO_0000115>A relation connecting an evidence type to an assertion method where the assertion method describes the type of process employed to evaluate the evidence.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-12-09T05:00:20Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>ECO:9000000</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>used_in</oboInOwl:id>
        <oboInOwl:shorthand>used_in</oboInOwl:shorthand>
        <rdfs:comment>In the future we may use a more generic relation with weaker domain and range constraints taken from IAO, RO or OBI.</rdfs:comment>
        <rdfs:label>used_in</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_9000000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A relation connecting an evidence type to an assertion method where the assertion method describes the type of process employed to evaluate the evidence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:SN</oboInOwl:hasDbXref>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/ECO_9000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/ECO_9000001">
        <obo:IAO_0000115>A relation that is an inverse of &quot;used_in&quot; relation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ECO:9000001</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>uses</oboInOwl:id>
        <oboInOwl:shorthand>uses</oboInOwl:shorthand>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_9000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A relation that is an inverse of &quot;used_in&quot; relation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:SN</oboInOwl:hasDbXref>
    </owl:Axiom>



