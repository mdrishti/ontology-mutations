    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:NamedIndividual rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>



    <!-- https://w3id.org/biolink/vocab/ameliorates_condition -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/ameliorates_condition">
        <biolink:opposite_of>exacerbates condition</biolink:opposite_of>
        <rdfs:label>ameliorates condition</rdfs:label>
        <skos:altLabel>ameliorates</skos:altLabel>
        <skos:altLabel>beneficial for condition</skos:altLabel>
        <skos:altLabel>therapeutic for condition</skos:altLabel>
        <skos:definition>Holds between an entity and an existing medical condition (disease or phenotypic feature) where the entity is able to ameliorate symptoms, stabilize progression, or cure the condition.</skos:definition>
        <skos:editorialNote>This predicate describes a narrower view of &apos;treats&apos; - that covers interventions that are beneficial for existing disease, and excludes interventions that prevent/reduce risk of developing a condition in the future.</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0003307"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <biolink:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</biolink:canonical_predicate>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/broad_match -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/broad_match">
        <biolink:opposite_of>narrow match</biolink:opposite_of>
        <rdfs:label>broad match</rdfs:label>
        <skos:definition>a list of terms from different schemas or terminology systems that have a broader, more general meaning. Broader terms are typically shown as parents in a hierarchy or tree.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#broadMatch"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q39894595"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <biolink:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</biolink:canonical_predicate>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/contraindicated_in -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/contraindicated_in">
        <biolink:opposite_of>treats</biolink:opposite_of>
        <rdfs:label>contraindicated in</rdfs:label>
        <skos:definition>Holds between a substance, procedure, or activity and a medical condition or circumstance, where an authority has established that the substance, procedure, or activity should not be applied as an intervention in patients with the condition or circumstance because it can result in detrimental outcomes.</skos:definition>
        <skos:editorialNote>This predicate relates the intervention with a specific disease, phenotype, or other medical circumstance that puts patients at high risk for detrimental outcomes.  This may be a different condition from the one that the drug would be used to treat (e.g. pseudoephedrine is contraindicated in people with high-blood pressure as a treatment for nasal congestion), a biological state (e.g. isotretinoin is contraindicated in people who are pregnant as a treatment for acne), or being on a different medication (e.g. aspirin is contraindicated in people taking warfarin as a preventative treatment for stroke).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C37933"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <biolink:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</biolink:canonical_predicate>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/decreases_sensitivity_to -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/decreases_sensitivity_to">
        <biolink:opposite_of>increases sensitivity to</biolink:opposite_of>
        <rdfs:label>decreases sensitivity to</rdfs:label>
        <skos:definition>holds between two chemical entities or genes or gene products where the action or effect of one decreases the susceptibility/sensitivity of a biological entity or system (e.g. an organism, cell, cellular component, macromolecular machine mixin, biological or pathological process) to the other</skos:definition>
        <skos:exactMatch rdf:resource="http://ctdbase.org/decreases_response_to"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="http://ctdbase.org/decreases_response_to_substance"/>
        <biolink:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</biolink:canonical_predicate>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/disrupts -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/disrupts">
        <biolink:opposite_of>enables</biolink:opposite_of>
        <rdfs:label>disrupts</rdfs:label>
        <skos:altLabel>disease causes disruption of</skos:altLabel>
        <skos:definition>describes a relationship where one entity degrades or interferes with the structure, function, or occurrence of another.</skos:definition>
        <skos:exactMatch rdf:resource="https://skr3.nlm.nih.gov/SemMedDBDISRUPTS"/>
        <skos:exactMatch rdf:resource="https://www.ebi.ac.uk/chembl/mechanism/inspect/disrupting_agent"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0004024"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0004025"/>
        <biolink:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</biolink:canonical_predicate>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/enabled_by -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/enabled_by">
        <biolink:opposite_of>prevented by</biolink:opposite_of>
        <rdfs:label>enabled by</rdfs:label>
        <skos:definition>holds between a process and a physical entity, where the physical entity executes the process</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/end_interbase_coordinate -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/end_interbase_coordinate">
        <biolink:opposite_of>start interbase coordinate</biolink:opposite_of>
        <rdfs:label>end interbase coordinate</rdfs:label>
        <skos:closeMatch rdf:resource="http://biohackathon.org/resource/faldo#end"/>
        <skos:definition>The position at which the subject nucleic acid entity ends on the chromosome or other entity to which it is located on.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/biolink/vocab/exacerbates_condition -->

    <owl:NamedIndividual rdf:about="https://w3id.org/biolink/vocab/exacerbates_condition">
        <biolink:opposite_of>ameliorates condition</biolink:opposite_of>
        <rdfs:label>exacerbates condition</rdfs:label>
        <skos:altLabel>detrimental for condition</skos:altLabel>
        <skos:altLabel>exacerbates</skos:altLabel>
        <skos:broadMatch rdf:resource="https://skr3.nlm.nih.gov/SemMedDBCOMPLICATES"/>
        <skos:definition>Holds between a substance, procedure, or activity and an existing medical condition (disease or phenotypic
 feature) where the substance, procedure, or activity worsens some or all aspects of the condition.</skos:definition>
