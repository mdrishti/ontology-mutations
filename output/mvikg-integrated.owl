        <rdfs:label>substitution</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_1000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sequence alteration where the length of the change in the variant is the same as that of the reference.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
