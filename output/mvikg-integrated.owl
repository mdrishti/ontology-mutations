        <oboInOwl:hasExactSynonym>nonsynonymous variant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0001992</oboInOwl:id>
        <rdfs:label>nonsynonymous_variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A non-synonymous variant is an inframe, protein altering variant, resulting in a codon change.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>non_synonymous_coding</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://ensembl.org/info/docs/variation/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>



